#!/usr/bin/env sh
export PATH="node_modules/.bin:$PATH"

# core.hooksPath is relative, so a worktree resolves its own tracked copy of this
# directory. A fresh worktree has no node_modules; install rather than skip.
if [ ! -d node_modules ]; then
  echo "git hooks - no node_modules in $(pwd), running npm ci"
  npm ci
fi

npm run lint
npm run typecheck
