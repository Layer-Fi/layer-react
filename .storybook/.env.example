# Copy to the repository root as `.env`, then run `vercel dev` alongside `npm run storybook:real`.

STORYBOOK_LAYER_BACKEND=real
STORYBOOK_LAYER_TOKEN_ENDPOINT=/api/storybook-token

# Server-side only. These must never gain a STORYBOOK_ prefix: Storybook inlines those into the
# client bundle, so prefixing the secret would publish it.
LAYER_APP_ID=
LAYER_APP_SECRET=
LAYER_ENVIRONMENT=sandbox
