# Copy to the repository root as `.env`, then run `vercel dev` alongside `npm run storybook:real`.
# The token endpoint holds every credential, so nothing secret belongs on the client side.

STORYBOOK_LAYER_BACKEND=real
STORYBOOK_LAYER_TOKEN_ENDPOINT=/api/storybook-token

# Server-side only — never prefixed STORYBOOK_, which Vite would inline into the bundle.
LAYER_STORYBOOK_APP_ID=
LAYER_STORYBOOK_APP_SECRET=
LAYER_STORYBOOK_ENVIRONMENT=sandbox
