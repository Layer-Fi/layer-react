# Copy to the repository root as `.env`, then run `vercel dev` alongside `npm run storybook:real`.

# Real mode comes from `npm run storybook:real`, never from here: Vite always loads the root
# `.env`, so setting STORYBOOK_LAYER_BACKEND in it would make plain `npm run storybook` real too.
STORYBOOK_LAYER_TOKEN_ENDPOINT=/api/storybook-token

# Only needed if `vercel dev` is not on its default port 3000. Not inlined into the client bundle;
# read by .storybook/main.ts on the Node side to configure the dev-server proxy.
# STORYBOOK_VERCEL_DEV_URL=http://localhost:3000

# Server-side only. These must never gain a STORYBOOK_ prefix: Storybook inlines those into the
# client bundle, so prefixing the secret would publish it.
LAYER_APP_ID=
LAYER_APP_SECRET=
LAYER_ENVIRONMENT=sandbox
